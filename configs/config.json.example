{
  "can_interface": "can0",
  "serial_port": "/dev/rfcomm0",
  "webhook_url": "https://script.google.com/macros/s/XXXXXX/exec",
  "poll_interval_ms": 50,
  "local_api_port": 9090,
  "maintenance_path": "/var/lib/pi-obd-meter/maintenance.json",
  "web_static_dir": "/opt/pi-obd-meter/web/static",
  "obd_protocol": "6",
  "max_speed_kmh": 180,
  "engine_displacement_l": 1.3,
  "initial_odometer_km": 98000,
  "throttle_idle_pct": 1,
  "throttle_max_pct": 197,
  "fuel_tank_l": 46,
  "fuel_rate_correction": 1.3,
  "eco_gradient_max_kmpl": 15,
  "trip_warn_km": 300,
  "trip_danger_km": 400,
  "coolant_temp": {
    "cold_max": 60,
    "normal_max": 100,
    "warning_max": 104
  },
  "oil_change": {
    "interval_km": 4000,
    "warning_km": 3000,
    "danger_km": 5000
  },
  "websocket": {
    "enabled": true,
    "broadcast_interval_ms": 50,
    "max_clients": 3
  }
}
